SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2.5

QDRANT_URL=http://localhost:6333
QDRANT_PATH=storage/qdrant_db
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi_chunks

EMBED_MODEL=intfloat/multilingual-e5-small
SQLITE_FTS_PATH=storage/chunks.sqlite

GENERATION_MODE=extractive

MIN_DENSE_SCORE=0.50
MIN_DENSE_MARGIN=0.055
MAX_CONTEXT_CHARS=1800
STT_CACHE_ENABLED=false

# ---- Vouch product settings ----
PRODUCT_NAME=Vouch
VOUCH_COLLECTIONS_DIR=storage/collections
MAX_UPLOAD_MB=20
# Leave empty for no auth (local use only); set to protect collection writes + insights.
ADMIN_TOKEN=

# Speech-to-text: auto | sarvam | whisper_api | faster_whisper
STT_PROVIDER=auto
WHISPER_API_BASE=
WHISPER_API_KEY=
WHISPER_API_KEYLESS=false
WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=small

EMERGENCY_TRIAGE=true

# Optional: translate verified quotes into the asker's language (OpenAI-compatible chat API)
TRANSLATE_ANSWERS=false
TRANSLATE_API_BASE=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=gpt-4o-mini

ANALYTICS_ENABLED=true
VOUCH_ANALYTICS_PATH=storage/analytics.sqlite
